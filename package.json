{
  "name": "xarm5-chessboard-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based 3D simulator for a simplified UFACTORY xArm 5 robot arm over a chessboard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:ik": "esbuild test-ik.mts --bundle --format=esm --platform=node --outfile=test-ik.bundle.mjs && node test-ik.bundle.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "playwright": "^1.61.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "three": "^0.160.0"
  }
}
